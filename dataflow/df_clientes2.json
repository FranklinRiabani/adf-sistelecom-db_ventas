{
	"name": "df_clientes2",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "clientes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "clientes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_cliente as integer,",
				"          {ci-nit} as integer,",
				"          nombre as string,",
				"          {fecha-nac} as string,",
				"          genero as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive({fecha-nac} = coalesce(\r",
				"    toDate({fecha-nac}, 'dd/MM/yyyy'),\r",
				"    toDate({fecha-nac}, 'dd-MM-yyyy'),\r",
				"    toDate({fecha-nac}, 'yyyy-MM-dd'),\r",
				"    toDate(\r",
				"        regexReplace(\r",
				"            lower({fecha-nac}),\r",
				"            'ene|feb|mar|abr|may|jun|jul|ago|sep|oct|nov|dic',\r",
				"            case(\r",
				"                regexMatch(lower({fecha-nac}), 'ene'), '01',\r",
				"                regexMatch(lower({fecha-nac}), 'feb'), '02',\r",
				"                regexMatch(lower({fecha-nac}), 'mar'), '03',\r",
				"                regexMatch(lower({fecha-nac}), 'abr'), '04',\r",
				"                regexMatch(lower({fecha-nac}), 'may'), '05',\r",
				"                regexMatch(lower({fecha-nac}), 'jun'), '06',\r",
				"                regexMatch(lower({fecha-nac}), 'jul'), '07',\r",
				"                regexMatch(lower({fecha-nac}), 'ago'), '08',\r",
				"                regexMatch(lower({fecha-nac}), 'sep'), '09',\r",
				"                regexMatch(lower({fecha-nac}), 'oct'), '10',\r",
				"                regexMatch(lower({fecha-nac}), 'nov'), '11',\r",
				"                regexMatch(lower({fecha-nac}), 'dic'), '12'\r",
				"            )\r",
				"        ),\r",
				"        'd/MM/yyyy'\r",
				"    )\r",
				")) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ID_CLIENTE as integer,",
				"          CI_NIT as integer,",
				"          NOMBRE as string,",
				"          FECHA_NAC as date,",
				"          GENERO as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ID_CLIENTE = id_cliente,",
				"          CI_NIT = {ci-nit},",
				"          NOMBRE = nombre,",
				"          FECHA_NAC = {fecha-nac},",
				"          GENERO = genero",
				"     )) ~> sink1"
			]
		}
	}
}